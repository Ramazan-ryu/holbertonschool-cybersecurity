  "policies": {
    "gp-deploy-policy": {
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "eks:*",
            "ecr:*",
            "s3:GetObject",
            "s3:PutObject"
          ],
          "Resource": "*"
        }
      ]
    },
    "gp-telemetry-read": {
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:ListBucket"
          ],
          "Resource": [
            "arn:aws:s3:::gp-grid-telemetry",
            "arn:aws:s3:::gp-grid-telemetry/*"
          ]
        },
        {
          "Effect": "Allow",
          "Action": [
            "kms:Decrypt"
          ],
          "Resource": "arn:aws:kms:*:210000000002:key/gp-platform-shared"
        }
      ]
    },
    "gp-reporting-broad": {
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "*:Describe*",
            "*:List*",
            "*:Get*"
          ],
          "Resource": "*"
        }
      ]
    }
  }
